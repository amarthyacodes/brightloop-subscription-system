DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/brightloop
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
PORT=3000
APP_BASE_URL=http://localhost:5173

# Optional SMTP settings. Without all four settings, reset links are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
